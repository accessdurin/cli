{
  "name": "@accessdurin/cli",
  "version": "1.1.0",
  "type": "module",
  "bin": {
    "durin": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "lint": "oxlint --config .oxlintrc.json .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "node scripts/check-secrets.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm secrets:check",
    "prepublishOnly": "pnpm verify",
    "skills:sync": "node scripts/sync-skills.mjs",
    "package:release": "node scripts/package-release.mjs",
    "release:metadata": "node scripts/release-metadata.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@napi-rs/keyring": "2.1.0",
    "@sentry/node": "11.10.0",
    "@sentry/node-cpu-profiler": "2.4.4",
    "@sentry/profiling-node": "11.10.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.4",
    "vitest": "^4.1.12",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2",
    "pnpm": "11.21.0"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "description": "Durin organization onboarding, governed tools, and MCP bridge CLI",
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/accessdurin/cli.git"
  },
  "homepage": "https://github.com/accessdurin/cli#readme",
  "bugs": {
    "url": "https://github.com/accessdurin/cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
