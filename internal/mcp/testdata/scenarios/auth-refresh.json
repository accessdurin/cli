{
  "description": "Stored grant: discovery (PRM at path), refresh succeeds and keeps the old refresh token when the server sends none; client secret selects client_secret_basic.",
  "provider": {
    "redirectUrl": "http://127.0.0.1:5555/oauth/callback",
    "state": "s",
    "clientMetadata": {"client_name": "Durin CLI", "redirect_uris": ["http://127.0.0.1:5555/oauth/callback"], "grant_types": ["authorization_code", "refresh_token"]},
    "clientInformation": {"client_id": "c-1", "client_secret": "sec", "issuer": "https://auth.example.test/"},
    "tokens": {"access_token": "old", "token_type": "Bearer", "refresh_token": "rt-old"}
  },
  "routes": [
    {"method": "GET", "path": "/.well-known/oauth-protected-resource/mcp", "responses": [{"status": 200, "json": {"resource": "https://app.example.test/mcp", "authorization_servers": ["https://auth.example.test/"]}}]},
    {"method": "GET", "path": "/.well-known/oauth-authorization-server", "responses": [{"status": 200, "json": {"issuer": "https://auth.example.test/", "authorization_endpoint": "https://auth.example.test/authorize", "token_endpoint": "https://auth.example.test/oauth/token", "response_types_supported": ["code"], "token_endpoint_auth_methods_supported": ["client_secret_post", "client_secret_basic"]}}]},
    {"method": "POST", "path": "/oauth/token", "responses": [{"status": 200, "json": {"access_token": "new", "token_type": "Bearer", "expires_in": 60}}]}
  ],
  "steps": [
    {"op": "auth", "serverUrl": "https://app.example.test/mcp"}
  ]
}
