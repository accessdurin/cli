{
  "description": "MAR-534 case 8: a revoked grant. The 401 triggers one refresh, refused with invalid_grant; tokens are invalidated and authorization restarts, where a non-interactive provider's state() refuses, so the send fails with the provider's error after exactly one request with the old token and one token request.",
  "provider": {
    "redirectUrl": "http://127.0.0.1/oauth/callback",
    "stateThrows": "sign in again",
    "clientMetadata": {"redirect_uris": ["http://127.0.0.1/oauth/callback"]},
    "tokens": {"access_token": "old-access", "token_type": "Bearer", "refresh_token": "old-refresh", "issuer": "https://app.example.test/"},
    "clientInformation": {"client_id": "client_one", "issuer": "https://app.example.test/"}
  },
  "client": {"name": "Durin CLI", "version": "1.0.0"},
  "transport": {"url": "https://app.example.test/mcp/u/aaa", "requestInit": {"redirect": "error"}, "onInsufficientScope": "throw"},
  "routes": [
    {"method": "GET", "path": "/.well-known/oauth-protected-resource/mcp/u/aaa", "responses": [{"status": 200, "json": {"resource": "https://app.example.test/mcp/u/aaa", "authorization_servers": ["https://app.example.test/"]}}]},
    {"method": "GET", "path": "/.well-known/oauth-authorization-server", "responses": [{"status": 200, "json": {"issuer": "https://app.example.test/", "authorization_endpoint": "https://app.example.test/authorize", "token_endpoint": "https://app.example.test/token", "response_types_supported": ["code"], "code_challenge_methods_supported": ["S256"]}}]},
    {"method": "POST", "path": "/token", "responses": [{"status": 400, "json": {"error": "invalid_grant", "error_description": "The grant was revoked."}}]},
    {"method": "POST", "path": "/mcp/u/aaa", "responses": [{"status": 401, "headers": {"www-authenticate": "Bearer error=\"invalid_token\""}}]}
  ],
  "steps": [
    {"op": "send", "message": {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "sandbox__read_document", "arguments": {}}}}
  ]
}
